# Copy to .env (never commit real values).
# `pnpm supabase:start` prints the local URL and anon key.

# Supabase project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-only secret used to pepper hashed public tokens (Edge Functions only).
TOKEN_PEPPER=

# Observability / analytics
SENTRY_DSN=
POSTHOG_KEY=

# Public base URL of the web app (links sent to customers)
PUBLIC_APP_URL=http://localhost:3000
