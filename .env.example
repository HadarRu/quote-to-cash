# Copy to .env (never commit real values). Both apps and the mobile app config read this file.
# `pnpm supabase:start` prints the local URL and anon key.

# Supabase project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-only secret used to pepper hashed public tokens (Edge Functions only).
TOKEN_PEPPER=

# Observability / analytics. POSTHOG_KEY is the project key (the app and the `notify` function
# send events with it); POSTHOG_HOST defaults to https://eu.i.posthog.com.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Push notifications. EXPO_PROJECT_ID: the app's EAS project (push tokens are issued per project).
# EXPO_ACCESS_TOKEN: only if "enhanced push security" is on in Expo (Edge Functions only).
# NOTIFY_SECRET: shared by the database and the `notify` function (Edge Functions only; also stored
# in Supabase Vault as `notify_secret`, see README).
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=
NOTIFY_SECRET=

# Public base URL of the web app (links sent to customers)
PUBLIC_APP_URL=http://localhost:3000
